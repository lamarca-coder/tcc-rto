# Copie este arquivo para ".env" e preencha com suas credenciais.
# O .env NÃO deve ser versionado (já está no .gitignore).

# ----- Reddit (https://www.reddit.com/prefs/apps) -----
# Crie um app do tipo "script" para obter client_id e client_secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tcc-rto-perceptions/0.1 by u/seu_usuario

# ----- X / Twitter (https://developer.x.com) -----
# Observação: o acesso de busca da API do X é restrito/pago.
# O coletor usa a API v2 (Bearer Token).
TWITTER_BEARER_TOKEN=

# ----- YouTube Data API (https://console.cloud.google.com) -----
# Ative "YouTube Data API v3" e crie uma "Chave de API".
YOUTUBE_API_KEY=

# ----- Kaggle API (kaggle.com -> Settings -> API -> Create New API Token) -----
# O token baixado (kaggle.json) contém {"username": "...", "key": "..."}.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ----- Bluesky (Settings -> App Passwords -> Add App Password) -----
# Use uma APP PASSWORD (não a senha real da conta).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
